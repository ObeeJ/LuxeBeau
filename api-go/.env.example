# LuxeBeau API configuration. Copy to .env and fill in real values.
# Never commit .env; it is git-ignored.

PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/luxebeau?sslmode=require
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Public web app URL (used in email links) and allowed browser origins.
APP_URL=https://luxebeau.ng
ALLOWED_ORIGINS=https://luxebeau.ng,https://www.luxebeau.ng

# Session cookies. Frontend and API must share a registrable domain
# (e.g. luxebeau.ng and api.luxebeau.ng) because cookies are SameSite=Strict.
COOKIE_DOMAIN=luxebeau.ng
COOKIE_SECURE=true

# Client IPs for rate limiting: set to "cloudflare" when proxied by Cloudflare.
TRUSTED_PLATFORM=cloudflare
TRUSTED_PROXIES=

# Email via Cloudflare Email Service (authenticated SMTP, beta).
# Username is the literal "api_token"; password is a Cloudflare API token
# with Email Sending permission. Port 465 uses implicit TLS.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USERNAME=api_token
SMTP_PASSWORD=
EMAIL_FROM=LuxeBeau <hello@luxebeau.ng>
# Development only: write emails to this folder instead of sending them.
MAIL_DEV_DIR=

# Google sign-in (OAuth client ID from Google Cloud Console).
GOOGLE_CLIENT_ID=

# Product and artisan photos via Cloudflare Images direct uploads.
CF_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_ACCOUNT_HASH=
CF_IMAGES_VARIANT=public

# Payment webhooks
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
MONNIFY_SECRET=
CRYPTO_WEBHOOK_SECRET=

# Identity verification
PREMBLY_API_KEY=
PREMBLY_APP_ID=
