{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxebeau",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".open-next/assets",
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "WEB_KV_CACHE_ID_PLACEHOLDER"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LUXEBEAU_MEDIA",
      "bucket_name": "luxebeau-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "luxebeau-web-cache"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.myluxebeau.com/api/v1",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY": "pk_test_8f297ae20d9fcad597746b3989cca684e971d9f8"
  }
}
